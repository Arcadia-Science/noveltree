params {
    aligner = 'famsa'
    msa_trimmer = 'none'
    tree_method = 'iqtree'
    tree_model = 'LG'
    tree_iqtree_max = 50
    iqtree_fasttree_fallback = true
    iqtree_timeout = '8s'
    iqtree_timeout_grace = '5s'
    max_cpus = 1
    max_memory = '1 GB'
    min_ungapped_length = 20
    min_num_seq_per_og = 4
    min_num_spp_per_og = 4
    preprocess = true
    min_protein_length = 2
}
env.PATH = "${projectDir}/../../bin:${projectDir}/bin:" + System.getenv('PATH')
executor.queueSize = 8
executor.pollInterval = '200 ms'
process {
    executor = 'local'
    cpus = 1
    memory = '1 GB'
    withName: '.*:TREES' {
        errorStrategy = 'ignore'
    }
}
