/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Arcadia Science production profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Bundles: awsbatch + zoogle + simplified + Arcadia AWS infrastructure defaults.

    Usage:
        nextflow run . -profile arcadia \
            --input samplesheet.csv \
            --outdir 's3://arcadia-noveltree/results' \
            --ncbi_email you@arcadiascience.com \
            -work-dir 's3://arcadia-noveltree/work'
----------------------------------------------------------------------------------------
*/

params {
    // Arcadia AWS Batch infrastructure
    awsqueue          = 'noveltree_weeping_willow'
    awsqueue_ondemand = 'noveltree_weeping_willow_ondemand'
    awsregion         = 'us-west-1'
    docker_registry   = '943220452459.dkr.ecr.us-west-1.amazonaws.com'

    // AWS cost allocation labels for Arcadia Batch runs.
    // Override these at launch with --cost_dataset, --cost_owner, or --cost_run_id.
    cost_project = 'noveltree'
    cost_dataset = 'unset'
    cost_owner   = System.getenv('USER') ?: 'unknown'
    cost_run_id  = System.getenv('NOVELTREE_RUN_ID') ?: new java.text.SimpleDateFormat('yyyyMMdd-HHmmss').format(new Date())

    // Pipeline mode
    preprocess = true

    // Global ceiling for standard tasks. OrthoFinder has a scoped override
    // below because its large plant datasets need more memory.
    max_memory = '512.GB'
}

process {
    resourceLabels = [
        Project : params.cost_project,
        Dataset : params.cost_dataset,
        Owner   : params.cost_owner,
        RunId   : params.cost_run_id,
        Pipeline: 'noveltree'
    ]

    withLabel:process_orthofinder {
        // This monolithic task cannot preserve partial progress across a Spot
        // interruption, so run it on the dedicated On-Demand queue.
        queue = params.awsqueue_ondemand
        cpus  = 64

        // The 16-thread run peaked near 399 GiB. Use the 1-TiB worker tier on
        // every attempt so 64 analysis threads retain ample memory headroom.
        memory = 960.GB
        time = { check_max(168.h, 'time') }
    }

    withName:SPECIESRAX {
        // SpeciesRax holds all core families simultaneously, and MPI ranks add
        // replicated process state. Both 128 ranks/960 GB and 192 ranks/1440 GB
        // were killed while initializing the 218-species large production dataset.
        // Keep the largest-memory worker but reduce MPI replication to 64 ranks.
        queue      = params.awsqueue_ondemand
        cpus       = 64
        memory     = 1440.GB
        time       = 168.h
        maxRetries = 2
    }

    withName:'NOVELTREE:REMAINING_GENE_FAMILIES:FASTTREE_TIER2' {
        // This override is intentionally limited to the remaining-family
        // FastTree tier. Existing named outputs are resolved from storeDir and
        // never reach AWS Batch. Keep unfinished trees on the standard queue
        // so scarce On-Demand capacity remains available to SpeciesRax.
        // Keep the FastTree command and model unchanged.
        queue = params.awsqueue
        cpus = {
            def n = (meta?.n_seq ?: 0) as long
            n >= (params.fasttree_large_family_min_sequences as long) \
                ? Math.min(
                    (params.fasttree_large_family_cpus as int) +
                        ((task.attempt - 1) * (params.fasttree_large_family_retry_cpu_step as int)),
                    params.max_cpus as int
                ) \
                : Math.min(16 * task.attempt, params.max_cpus as int)
        }
        memory = {
            def n = (meta?.n_seq ?: 50) as long
            def maxMem = params.max_memory as nextflow.util.MemoryUnit
            def length = (meta?.max_len ?: 500) as long
            def profileBytes = n * length * 165L * 3L
            def njBytes = (long)(16.0 * Math.pow(n, 1.5))
            def estimatedGb = Math.max(
                8L,
                (long)((profileBytes + njBytes) / (1024L * 1024L * 1024L)) + 2L
            )
            def cappedGb = (int)Math.min(estimatedGb, 128L)
            def multiplier = n >= (params.fasttree_large_family_min_sequences as long) \
                ? (params.fasttree_large_family_memory_multiplier as int) + task.attempt - 1 \
                : task.attempt
            def requested = cappedGb.GB * multiplier
            requested.compareTo(maxMem) > 0 ? maxMem : requested
        }
        time = {
            def n = (meta?.n_seq ?: 0) as long
            def maxTime = params.max_time as nextflow.util.Duration
            def requested = n >= (params.fasttree_large_family_min_sequences as long) \
                ? (task.attempt == 1 \
                    ? params.fasttree_large_family_time as nextflow.util.Duration \
                    : params.fasttree_large_family_retry_time as nextflow.util.Duration) \
                : 3.h * Math.pow(3, task.attempt - 1)
            requested.compareTo(maxTime) > 0 ? maxTime : requested
        }
    }
}
