/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

// Shared FastTree arguments for both direct use and IQ-TREE fallback.
// Evidence-based "maximum accuracy" settings from the FastTree documentation
// (morgannprice.github.io/fasttree/#MoreAcc) and benchmarking literature:
//   -lg:        LG substitution model (Le & Gascuel 2008), matches IQ-TREE LG+F+G4
//   -gamma:     rescale branch lengths under Gamma20 likelihood (~5% slower; Price et al. 2010)
//   -bionj:     weighted joins for better starting tree (Gascuel 1997)
//   -pseudo:    pseudocounts for gappy/fragmentary sequences (Price et al. 2010)
//   -spr 4:     4 rounds of ME-SPR moves, up from default 2 (Price et al. 2010, §Methods)
//   -mlacc 2:   optimize all 5 branches in 2 rounds per ML-NNI (Price et al. 2010, Table S2)
//   -slownni:   disable heuristics that skip constant subtrees during NNI (Price et al. 2010)
// Zhou et al. (2018, MBE 35:486-503) benchmarked these settings on 19 empirical datasets.
def fasttree_args = [
    '-lg',
    '-gamma',
    '-bionj',
    '-pseudo',
    '-spr 4',
    '-mlacc 2',
    '-slownni'
].join(' ')

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]
    withName: 'SAMPLESHEET_CHECK' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    if (params.msa_trimmer == 'cialign') {
        withName: 'CIALIGN' {
            ext.args = [
                '--crop_divergent_min_prop_ident=0.25',
                '--crop_divergent_min_prop_nongap=0.25',
                '--crop_ends',
                '--remove_insertions',
                '--insertion_min_size=5',
                '--insertion_max_size=200',
                '--remove_divergent',
                '--remove_divergent_minperc=0.15'
            ].join(' ')
            publishDir = [enabled: false]
        }
    }
    withName: 'DIAMOND_BLASTP' {
        ext.args = [
            '--ultra-sensitive'
        ].join(' ')
        publishDir = [enabled: false]
    }
    if (params.aligner != 'witch') {
        withName: 'MAFFT' {
            ext.args = [
                '--localpair',
                '--maxiterate 1000',
                '--anysymbol'
            ].join(' ')
            publishDir = [enabled: false]
        }
    }
    if (params.tree_method == 'fasttree') {
        withName: 'FASTTREE' {
            ext.args = fasttree_args
            publishDir = [enabled: false]
        }
    }
    withName: 'SPECIESRAX' {
        ext.args = [
            '--rec-model UndatedDL',
            '--si-strategy SKIP',
            '--si-quartet-support'
        ].join(' ')
        publishDir = [enabled: false]
    }
    withName: 'GENERAX_PER_FAMILY' {
        ext.args = [
            '--rec-model UndatedDL',
            '--strategy SPR'
        ].join(' ')
    }
    withName: 'GENERAX_PER_SPECIES' {
        ext.args = [
            '--rec-model UndatedDL',
            '--strategy SPR'
        ].join(' ')
    }
    withName: 'ASTEROID' {
        ext.args = [
            '--random-starting-trees 10',
            '--bs-replicates 100'
        ].join(' ')
        publishDir = [enabled: false]
    }
    withName: 'PHYLO_PROFILES' {
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
        publishDir = [enabled: false]
    }
    withName: 'DOWNLOAD_INPUT' {
        publishDir = [enabled: false]
    }
    withName: 'TRANSDECODER' {
        publishDir = [enabled: false]
    }
    withName: 'FILTER_ISOFORMS' {
        publishDir = [enabled: false]
    }
    withName: 'PREPROCESS_PROTEOME' {
        publishDir = [enabled: false]
    }
    withName: 'PROTEIN_PROPERTIES' {
        publishDir = [enabled: false]
    }
    withName: 'BUILD_REFERENCE_CHRONOGRAM' {
        publishDir = [enabled: false]
    }
    withName: 'DATE_GENE_FAMILY_TREES' {
        publishDir = [enabled: false]
    }
    withName: 'TIME_CALIBRATE_SPECIES_TREE' {
        publishDir = [enabled: false]
    }
    withName: 'ZOOGLE_ANALYSIS' {
        publishDir = [enabled: false]
    }
    // Suppress default publishDir for storeDir processes without other config
    withName: 'RENAME_FASTAS' {
        publishDir = [enabled: false]
    }
    withName: 'ORTHOFINDER_PREP_ALL' {
        publishDir = [enabled: false]
    }
    withName: 'FAMSA' {
        publishDir = [enabled: false]
    }
    withName: 'MAFFT_TIER1' {
        publishDir = [enabled: false]
    }
    withName: 'CLIPKIT' {
        publishDir = [enabled: false]
    }
    withName: 'IQTREE' {
        publishDir = [enabled: false]
    }
    // Legacy single-aligner mode aliases WITCH/FAMSA/MAFFT as ALIGN_SEQS; suppress its
    // stray default publish (all aligners persist via storeDir under alignments/).
    withName: 'ALIGN_SEQS' {
        publishDir = [enabled: false]
    }
    // ORTHOFINDER_MCL_ALL keeps its existing publish of the CSVs + complete_dataset/ under
    // orthofinder/, and additionally mirrors only the flat per-OG unaligned FASTAs to
    // alignments/unaligned/ (the species-tree vs gene-tree split is derived downstream
    // from the membership CSVs, so the FASTAs are no longer published under orthofinder/).
    withName: 'ORTHOFINDER_MCL_ALL' {
        publishDir = [
            [
                path: { "${params.outdir}/orthofinder" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> (filename.equals('versions.yml') || filename.startsWith('unaligned/')) ? null : filename }
            ],
            [
                path: { "${params.outdir}/alignments/unaligned" },
                mode: params.publish_dir_mode,
                pattern: 'unaligned/*.fa',
                saveAs: { filename -> filename.tokenize('/').last() }
            ]
        ]
    }
    withName: 'PARSE_PHYLOHOGS' {
        publishDir = [enabled: false]
    }
    // Adaptive alignment mode: any failure (tool or infrastructure) in tier 1/2
    // is immediately ignored. Vanished OGs are detected by the subworkflow and
    // routed to FAMSA_FALLBACK. FAMSA_TIER3 and FAMSA_FALLBACK keep retries
    // as they are the last resort.
    if (params.aligner == 'adaptive') {
        withName: 'MAFFT_TIER1' {
            errorStrategy = 'ignore'
            publishDir = [enabled: false]
        }
        withName: 'WITCH_TIER2' {
            errorStrategy = 'ignore'
            publishDir = [enabled: false]
        }
        withName: 'FAMSA_TIER3' {
            ext.args      = '-medoidtree'
            errorStrategy = 'retry'
            maxRetries    = 3
            publishDir = [enabled: false]
        }
        withName: 'FAMSA_FALLBACK' {
            ext.args      = ''
            cpus          = { Math.min(16, 8 * task.attempt) }
            errorStrategy = 'retry'
            maxRetries    = 3
            publishDir = [enabled: false]
        }
    }
    // IQ-TREE fallback mode: any failure is immediately ignored. Vanished OGs
    // are detected by the subworkflow and routed to FASTTREE_FALLBACK.
    if (params.iqtree_fasttree_fallback) {
        withName: 'TREES' {
            errorStrategy = 'ignore'
        }
        withName: 'FASTTREE_FALLBACK' {
            ext.args = fasttree_args
            publishDir = [enabled: false]
        }
    }

    // Simplified mode: use weeping-willow settings for faster execution
    if (params.simplified) {
        withName: 'GENERAX_PER_SPECIES' {
            ext.args = [
                '--rec-model UndatedDL',
                '--strategy EVAL'
            ].join(' ')
        }
        withName: 'SPECIESRAX' {
            ext.args = [
                '--rec-model UndatedDL',
                '--si-quartet-support'
            ].join(' ')
            publishDir = [enabled: false]
        }
        withName: 'WITCH' {
            stageInMode = 'copy'
        }
        withName: 'FAMSA' {
            ext.args = [
                '-gt upgma'
            ].join(' ')
            publishDir = [enabled: false]
        }
    }
}
