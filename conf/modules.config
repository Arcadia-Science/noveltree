/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

// Shared FastTree arguments for both direct use and IQ-TREE fallback
def fasttree_args = [
    '-lg',
    '-cat 20',
    '-gamma',
    '-sprlength 50',
    '-mlacc 3',
    '-topm 2',
    '-bionj'
].join(' ')

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]
    withName: 'SAMPLESHEET_CHECK' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    if (params.msa_trimmer == 'cialign') {
        withName: 'CIALIGN' {
            ext.args = [
                '--crop_divergent_min_prop_ident=0.25',
                '--crop_divergent_min_prop_nongap=0.25',
                '--crop_ends',
                '--remove_insertions',
                '--insertion_min_size=5',
                '--insertion_max_size=200',
                '--remove_divergent',
                '--remove_divergent_minperc=0.15'
            ].join(' ')
        }
    }
    withName: 'DIAMOND_BLASTP' {
        ext.args = [
            '--ultra-sensitive'
        ].join(' ') 
    }
    if (params.aligner != 'witch') {
        withName: 'MAFFT' {
            ext.args = [
                '--localpair',
                '--maxiterate 1000',
                '--anysymbol'
            ].join(' ') 
        }
    }
    if (params.tree_method == 'fasttree') {
        withName: 'FASTTREE' {
            ext.args = fasttree_args
        }
    }
    withName: 'SPECIESRAX' {
        ext.args = [
            '--rec-model UndatedDTL',
            '--si-strategy SKIP', 
            '--si-quartet-support'
        ].join(' ') 
    }
    withName: 'GENERAX_PER_FAMILY' {
        ext.args = [
            '--rec-model UndatedDTL',
            '--strategy SPR'
        ].join(' ') 
    }
    withName: 'GENERAX_PER_SPECIES' {
        ext.args = [
            '--rec-model UndatedDTL',
            '--strategy SPR'
        ].join(' ') 
    }
    withName: 'ASTEROID' {
        ext.args = [
            '--random-starting-trees 10',
            '--bs-replicates 100'
        ].join(' ')
    }
    withName: 'ORTHOXML_PHYLOHOGS' {
        publishDir = [
            [
                path: "${params.outdir}/orthology/orthoxml",
                mode: params.publish_dir_mode,
                pattern: "*.orthoxml"
            ]
        ]
    }
    withName: 'PHYLO_PROFILES' {
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
        // Don't publish individual per-OG outputs
        publishDir = [
            enabled: false
        ]
    }
    withName: 'MERGE_PHYLO_PROFILES' {
        publishDir = [
            path: "${params.outdir}/gene_family_evolution",
            mode: params.publish_dir_mode,
            pattern: "*"
        ]
    }
    withName: 'DOWNLOAD_INPUT' {
        publishDir = [
            enabled: false
        ]
    }
    withName: 'TRANSDECODER' {
        publishDir = [
            path: "${params.outdir}/preprocessing/transdecoder",
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'FILTER_ISOFORMS' {
        publishDir = [
            enabled: false
        ]
    }
    withName: 'PREPROCESS_PROTEOME' {
        publishDir = [
            path: "${params.outdir}/preprocessing/preprocessed_proteomes",
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'PREQUAL' {
        publishDir = [
            path: "${params.outdir}/alignments/prequal_masked",
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'PHYSICOCHEMICAL_PROPS' {
        publishDir = [
            path: "${params.outdir}/physicochemical_properties",
            mode: params.publish_dir_mode,
            pattern: "aa-summary-stats"
        ]
    }
    withName: 'BUILD_REFERENCE_CHRONOGRAM' {
        publishDir = [
            path: "${params.outdir}/species_trees/reference_chronogram",
            mode: params.publish_dir_mode,
            pattern: "*"
        ]
    }
    withName: 'DATE_GENE_FAMILY_TREES' {
        publishDir = [
            [
                path: "${params.outdir}/gene_family_trees/time_calibrated",
                mode: params.publish_dir_mode,
                pattern: "*_dated.newick"
            ],
            [
                path: "${params.outdir}/gene_family_trees/time_calibrated/calibrations",
                mode: params.publish_dir_mode,
                pattern: "*_calibrations.csv"
            ]
        ]
    }
    withName: 'TIME_CALIBRATE_SPECIES_TREE' {
        publishDir = [
            path: "${params.outdir}/species_trees/time_calibrated",
            mode: params.publish_dir_mode,
            pattern: "*"
        ]
    }
    withName: 'ZOOGLE' {
        publishDir = [
            path: "${params.outdir}/zoogle",
            mode: params.publish_dir_mode,
            pattern: "{phylo-corrected-data,protein-dist-mats,protein-phylo-dist-mats,protein-dists-to-reference,species-dists-to-reference,protein-pvals,species-pvals,pairwise-protein-dist-perm-test,final_protein_pair_summary_tables}/**"
        ]
    }
    // Adaptive alignment mode: tier 1/2 failures route to FAMSA fallback
    if (params.adaptive_align) {
        withName: 'MAFFT_ADAPTIVE' {
            errorStrategy = 'ignore'
            maxRetries    = 0
        }
        withName: 'WITCH_TIER2' {
            errorStrategy = 'ignore'
            maxRetries    = 0
        }
        withName: 'FAMSA_TIER3' {
            ext.args      = '-medoidtree'
            errorStrategy = 'retry'
            maxRetries    = 3
        }
        withName: 'FAMSA_FALLBACK' {
            ext.args      = '-medoidtree'
            errorStrategy = 'retry'
            maxRetries    = 3
        }
    }
    // IQ-TREE fallback mode: ignore errors so failed jobs route to FastTree
    if (params.iqtree_fasttree_fallback) {
        withName: 'TREES' {
            errorStrategy = 'ignore'
            maxRetries    = 0
        }
        withName: 'FASTTREE_FALLBACK' {
            ext.args = fasttree_args
            publishDir = [
                path: "${params.outdir}/gene_family_trees/original",
                mode: params.publish_dir_mode,
                saveAs: { fn -> fn.substring(fn.lastIndexOf('/')+1) },
            ]
        }
    }

    // Simplified mode: use weeping-willow settings for faster execution
    if (params.simplified) {
        withName: 'GENERAX_PER_SPECIES' {
            ext.args = [
                '--rec-model UndatedDTL',
                '--strategy EVAL'
            ].join(' ')
        }
        withName: 'SPECIESRAX' {
            ext.args = [
                '--rec-model UndatedDTL',
                '--si-quartet-support'
            ].join(' ')
        }
        withName: 'WITCH' {
            stageInMode = 'copy'
        }
        withName: 'FAMSA' {
            ext.args = [
                '-gt upgma'
            ].join(' ')
        }
    }
}
