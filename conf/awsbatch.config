/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Arcadia-Science/noveltree AWS Batch config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Configuration for running on AWS Batch
----------------------------------------------------------------------------------------
*/

// Set process executor and queue
process {
    executor = 'awsbatch'
    queue = params.awsqueue
}

// AWS configuration
aws {
    region = params.awsregion
    batch {
        cliPath              = '/home/ec2-user/miniconda/bin/aws'
        maxTransferAttempts  = 3            // Default: 1. Retry failed S3 transfers in Batch jobs.
        delayBetweenAttempts = '15 sec'     // Default: 10s. Pause between transfer retries.
        retryMode            = 'adaptive'   // Default: standard. Client-side rate limiting on throttled APIs.
    }
    client {
        maxConnections    = 20          // Default: 50. Limit concurrent S3 requests to avoid 503 SlowDown.
        maxErrorRetry     = 10          // Default: ~3 (SDK). Retry transient S3 503 SlowDown errors.
        connectionTimeout = 30000       // Default: 10000ms. More time for connection setup under contention.
    }
}

// Enable Docker for AWS Batch
docker {
    enabled = true
    registry = params.docker_registry
}

// AWS Batch executor settings
executor {
    name            = 'awsbatch'
    queueSize       = 10000         // Allow large gene-family batches to use the full Batch compute environment.
    submitRateLimit = '50/1sec'     // Throttle submissions to prevent S3 write burst overload.
    pollInterval    = '30 sec'      // Default: 10s. Reduces Batch DescribeJobs API pressure.
}

// Enable pipeline resumption by allowing report overwrites
timeline.overwrite = true
report.overwrite = true
trace.overwrite = true
dag.overwrite = true
