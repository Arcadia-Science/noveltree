/* Opt-in allocations for exceptionally large whole-proteome datasets. */

params {
    config_profile_name = 'Arcadia large-run profile'
    config_profile_description = 'On-Demand high-memory allocations validated on the 218-species large production plant dataset'
    max_memory = '1500.GB'
}

process {
    withLabel:process_orthofinder {
        // OrthoFinder clustering is a monolithic whole-dataset task. The
        // large production run peaked near 400 GiB at 16 threads, so this profile uses
        // the validated 1-TiB worker tier and avoids Spot interruption.
        queue      = params.awsqueue_ondemand
        cpus       = 64
        memory     = 960.GB
        time       = 168.h
    }

    withName:SPECIESRAX {
        // SpeciesRax holds the selected core families simultaneously and MPI
        // ranks replicate state. These values are the successful large production
        // allocation, isolated here from ordinary Arcadia runs.
        queue      = params.awsqueue_ondemand
        cpus       = 64
        memory     = 1440.GB
        time       = 168.h
        maxRetries = 2
    }
}
