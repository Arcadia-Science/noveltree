/* Opt-in resource policy for exceptionally large whole-proteome datasets. */

params {
    config_profile_name = 'Arcadia large-run profile'
    config_profile_description = 'On-Demand high-memory allocations validated on a 218-species plant dataset'
    max_memory = '1500.GB'

    // Large-family FastTree thresholds validated during a large plant run.
    fasttree_large_family_min_sequences = 15000
    fasttree_large_family_cpus = 48
    fasttree_large_family_retry_cpu_step = 16
    fasttree_large_family_memory_multiplier = 3
    fasttree_large_family_time = '168.h'
    fasttree_large_family_retry_time = '240.h'
}

process {
    withLabel:process_bundle {
        // Reserve sufficient per-job footprint to avoid packing many
        // simultaneous S3/tar operations onto one worker.
        cpus   = 8
        memory = 16.GB
        time   = 4.h
    }

    withLabel:process_orthofinder {
        // OrthoFinder clustering is a monolithic whole-dataset task. The
        // A 218-species plant run peaked near 400 GiB at 16 threads, so this profile uses
        // the validated 1-TiB worker tier and avoids Spot interruption.
        queue      = params.awsqueue_ondemand
        cpus       = 64
        memory     = 960.GB
        time       = 168.h
    }

    withName:SPECIESRAX {
        // SpeciesRax holds the selected core families simultaneously and MPI
        // ranks replicate state. These values are the validated production
        // allocation, isolated here from ordinary Arcadia runs.
        queue      = params.awsqueue_ondemand
        cpus       = 64
        memory     = 1440.GB
        time       = 168.h
        maxRetries = 2
    }

    withName:'FASTTREE_TIER2|FASTTREE_FALLBACK' {
        cpus = {
            def n = (meta?.n_seq ?: 0) as long
            n >= (params.fasttree_large_family_min_sequences as long) \
                ? Math.min(
                    (params.fasttree_large_family_cpus as int) +
                        ((task.attempt - 1) * (params.fasttree_large_family_retry_cpu_step as int)),
                    params.max_cpus as int
                ) \
                : Math.min(16 * task.attempt, params.max_cpus as int)
        }
        memory = {
            def n = (meta?.n_seq ?: 50) as long
            def length = (meta?.max_len ?: 500) as long
            def profileBytes = n * length * 165L * 3L
            def njBytes = (long)(16.0 * Math.pow(n, 1.5))
            def estimatedGb = Math.max(
                8L,
                (long)((profileBytes + njBytes) / (1024L * 1024L * 1024L)) + 2L
            )
            def cappedGb = (int)Math.min(estimatedGb, 128L)
            def multiplier = n >= (params.fasttree_large_family_min_sequences as long) \
                ? (params.fasttree_large_family_memory_multiplier as int) + task.attempt - 1 \
                : task.attempt
            def requested = cappedGb.GB * multiplier
            def maxMem = params.max_memory as nextflow.util.MemoryUnit
            requested.compareTo(maxMem) > 0 ? maxMem : requested
        }
        time = {
            def n = (meta?.n_seq ?: 0) as long
            def maxTime = params.max_time as nextflow.util.Duration
            def requested = n >= (params.fasttree_large_family_min_sequences as long) \
                ? (task.attempt == 1 \
                    ? params.fasttree_large_family_time as nextflow.util.Duration \
                    : params.fasttree_large_family_retry_time as nextflow.util.Duration) \
                : 3.h * Math.pow(3, task.attempt - 1)
            requested.compareTo(maxTime) > 0 ? maxTime : requested
        }
    }

    withName:CLIPKIT {
        time = {
            def bytes = fasta.size() as long
            def mib = 1024L * 1024L
            bytes >= 1024L * mib ? 168.h :
            bytes >=  512L * mib ?  72.h :
            bytes >=  256L * mib ?  48.h :
            bytes >=  128L * mib ?  24.h : 12.h
        }
        memory = {
            def bytes = fasta.size() as long
            def mib = 1024L * 1024L
            def baseGb = bytes >= 1024L * mib ? 480L :
                         bytes >=  512L * mib ? 240L :
                         bytes >=  256L * mib ? 120L :
                         bytes >=  128L * mib ?  60L :
                         bytes >=   64L * mib ?  30L : 8L
            def multiplier = task.attempt > 1 ? 2L : 1L
            def requested = Math.min(baseGb * multiplier, 480L).GB
            def maxMem = params.max_memory as nextflow.util.MemoryUnit
            requested.compareTo(maxMem) > 0 ? maxMem : requested
        }
    }
}
